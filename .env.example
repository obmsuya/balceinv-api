# Cloud: set DATABASE_URL (Postgres). Desktop: leave it empty; DB_PATH is optional (defaults to the app data folder).
DATABASE_URL=
DB_PATH=

# Required in cloud, comma separated. Desktop defaults to localhost:3000 and the Tauri origins.
ALLOWED_ORIGINS=

# Default 127.0.0.1:8080. Use 0.0.0.0:8080 only behind Caddy or when LAN mode is switched on.
LISTEN_ADDR=

# Default: ./logs in cloud, <database folder>/logs on desktop.
LOG_DIR=

# Desktop LAN mode only: folder with the built frontend served to other tills.
BALCE_STATIC_DIR=

# Cloud: object storage (Garage). Desktop: leave empty; media is kept in MEDIA_DIR (default <database folder>/media).
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_DIR=

# Team tools passcode for the common product lists: SHA-256 hex of the passcode (printf %s "passcode" | shasum -a 256).
# Desktop release builds compile it in; leave empty to turn team tools off.
BALCE_SUPPORT_PASSCODE_HASH=

# Desktop licensing. Release builds compile the secret in; BALCE_LICENSE_CHECK=off skips the check for local development.
BALCE_LICENSE_SECRET=
BALCE_LICENSE_CHECK=

# Set to 1 by the desktop app: the server stops when its stdin closes, so it never outlives the app.
BALCE_EXIT_WITH_PARENT=

# Support messages from the app are emailed to the Balce team. Defaults: Yahoo SMTP on 465 (implicit TLS),
# sent from SUPPORT_SMTP_USERNAME to SUPPORT_EMAIL_TO. SUPPORT_SMTP_PASSWORD is a Yahoo app password;
# release builds compile it in. With no password, messages are kept and sent once one is set.
SUPPORT_SMTP_HOST=
SUPPORT_SMTP_PORT=
SUPPORT_SMTP_USERNAME=
SUPPORT_SMTP_PASSWORD=
SUPPORT_EMAIL_TO=
SUPPORT_EMAIL_FROM=
